/* Apple-inspired Light Theme: clean, minimal, legible */

QWidget {
    background-color: #fdfdfd;
    color: #1c1c1e;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen;
    font-size: 14px;
}

QPushButton {
    background-color: #e9e9eb;
    border: 1px solid #d0d0d2;
    border-radius: 6px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #dcdcdc;
}

QComboBox {
    background-color: #ffffff;
    border: 1px solid #ccc;
    padding: 4px;
}

QTabWidget::pane {
    background: #ffffff;
    border: 1px solid #ccc;
    border-radius: 4px;
}

QTabBar::tab {
    background: #f5f5f7;
    border: 1px solid #ccc;
    padding: 6px 10px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #ffffff;
    border-bottom-color: #ffffff;
}

QLabel {
    font-weight: 500;
    color: #1c1c1e;
}

QToolBar {
    background-color: #f2f2f4;
    spacing: 8px;
    padding: 4px;
    border-bottom: 1px solid #ccc;
}

QLineEdit {
    background: #fff;
    border: 1px solid #ccc;
    padding: 4px;
    border-radius: 4px;
}

QCheckBox {
    spacing: 6px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
}
